<component type="desktop-application">
	<id>eu.nimmerfort.blackbody</id>
  <launchable type="desktop-id">eu.nimmerfort.blackbody.desktop</launchable>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>EUPL-1.2</project_license>
  <name>Blackbody</name>
	<summary>An image viewer for thermograms.</summary>
  <description><p>An image viewer for viewing thermograms made by FLIR cameras or raw thermal data in TIFFs.</p>></description>
  <url type="homepage">https://bitbucket.org/nimmerwoner/blackbody/</url>
  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.0" date="2020-10-14" urgency="low" type="development">
      <description>
        <p>First release of Blackbody: ready for use, although still in beta. The most important features are:</p>
        <ul>
          <li>Loading FLIR thermograms from many cameras</li>
          <li>Loading single-band TIFFs assumed to be in °C</li>
          <li>Rendering to many different colors palettes, including inferno and turbo</li>
          <li>Specify the thermal range to render</li>
          <li>Zoom in and out</li>
        </ul>
      </description>
    </release>
  </releases>

  <screenshots>
    <screenshot>
      <caption>The Blackbody application</caption>
      <image type="source" width="682" height="569">https://bitbucket.org/nimmerwoner/blackbody/downloads/blackbody-01.png</image>
    </screenshot>
  </screenshots>
</component>
