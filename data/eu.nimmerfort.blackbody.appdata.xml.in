<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2020 Arthur Nieuwland -->
<component type="desktop-application">
  <name>Blackbody</name>
	<summary>A thermogram viewer.</summary>
	<id>eu.nimmerfort.blackbody</id>
  <launchable type="desktop-id">eu.nimmerfort.blackbody.desktop</launchable>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>EUPL-1.2</project_license>
  <url type="homepage">https://bitbucket.org/nimmerwoner/blackbody/</url>
  <content_rating type="oars-1.1" />
  <translation type="gettext">blackbody</translation>
  <developer_name>Arthur Nieuwland</developer_name>
  <update_contact>anieuwland@nimmerfort.eu</update_contact>

  <description>
    <p>Blackbody is a thermogram viewer. It renders temperature data to RGB images.</p>
    <p>Features:</p>
    <ul>
      <li>Loading FLIR thermograms from many cameras</li>
      <li>Loading single-band TIFFs assumed to be in °C</li>
      <li>Rendering to many different colors palettes, including inferno and turbo</li>
      <li>Specifying the thermal range to render</li>
      <li>Zooming in and out</li>
      <li>Translated to multiple languages</li>
      <li>Available for Linux and Windows</li>
    </ul>
    <p>Cameras known to work:</p>
    <ul>
      <li>FLIR C2</li>
      <li>FLIR E4</li>
      <li>FLIR E5</li>
      <li>FLIR E6</li>
      <li>FLIR E8</li>
      <li>FLIR E8XT</li>
      <li>FLIR E53</li>
      <li>FLIR E75</li>
      <li>FLIR P60 (PAL)</li>
      <li>FLIR T630SC</li>
      <li>FLIR T660</li>
    </ul>
  </description>

  <releases>
    <release version="1.1.0" date="2020-12-29" urgency="low" type="stable">
      <description>
        <p>A small, incremental update to Blackbody. Improvements:</p>
        <ul>
          <li>An error message is shown if opening a thermogram fails</li>
          <li>When opening fails, Blackbody doesn't unload any loaded thermograms anymore</li>
          <li>Added logo's heat waves as a nicer placeholder when no thermogram is opened yet</li>
          <li>Refined headerbar controls to only be sensitive when a thermogram is opened</li>
          <li>Three more known-to-be-compatible cameras (FLIR C2, FLIR E5 and FLIR P60)</li>
        </ul>
      </description>
    </release>

    <release version="1.0.0" date="2020-12-28" urgency="low" type="stable">
      <description>
        <p>First release of Blackbody. The most important features are:</p>
        <ul>
          <li>Loading FLIR thermograms from many cameras</li>
          <li>Loading single-band TIFFs assumed to be in °C</li>
          <li>Rendering to many different colors palettes, including inferno and turbo</li>
          <li>Specifying the thermal range to render</li>
          <li>Zooming in and out</li>
          <li>Translated to multiple languages</li>
          <li>Available for Linux and Windows</li>
        </ul>
      </description>
    </release>
  </releases>

