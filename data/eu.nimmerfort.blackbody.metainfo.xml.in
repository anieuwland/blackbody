<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2022 Arthur Nieuwland -->
<component type="desktop-application">
  <name>Blackbody</name>
	<summary>Inspect thermograms</summary>
	<id>eu.nimmerfort.blackbody</id>
  <launchable type="desktop-id">eu.nimmerfort.blackbody.desktop</launchable>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>EUPL-1.2</project_license>
  <url type="homepage">https://github.com/anieuwland/blackbody</url>
  <url type="bugtracker">https://github.com/anieuwland/blackbody/issues</url>
  <url type="vcs-browser">https://github.com/anieuwland/blackbody</url>
  <url type="translate">https://github.com/anieuwland/blackbody/tree/main/po</url>
  <url type="contact">https://nimmerfort.eu/</url>
  <content_rating type="oars-1.1" />
  <translation type="gettext">blackbody</translation>
  <developer id="eu.nimmerfort">
    <name>Arthur Nieuwland</name>
  </developer>
  <update_contact>anieuwland@nimmerfort.eu</update_contact>
  <branding>
    <color type="primary" scheme_preference="light">#f3a507</color>
    <color type="primary" scheme_preference="dark">#af208f</color>
  </branding>
  <requires>
    <display_length compare="ge">768</display_length>
    <control>pointing</control>
  </requires>
  <recommends>
    <control>keyboard</control>
  </recommends>

  <description>
    <p>Blackbody is a viewer for FLIR and Fluke thermograms and other thermal images. Explore temperatures under the cursor, render to different palettes and ranges, overlay the visible-light photo, and inspect embedded measurements and camera metadata.</p>
    <p>Blackbody reads thermograms from many FLIR cameras, including the visible-light photo, and also opens Fluke thermograms from cameras such as the Ti400, Ti401p, TiS75+, and Ti25. Plain thermal data can be imported and exported as single-band TIFFs or 16-bit PNGs.</p>
    <p>Features:</p>
    <ul>
      <li>Inspect the temperature under the cursor, in celsius, fahrenheit, or kelvin</li>
      <li>View embedded measurements: spots, lines, and areas</li>
      <li>Overlay view (Picture-in-Picture or MSX) combining thermal and visible images</li>
      <li>Render to the camera's embedded palette or many built-in ones, including inferno and turbo</li>
      <li>Adjust the temperature range to make details stand out</li>
      <li>Metadata panel with camera info and GPS location, openable in a map</li>
      <li>Export renders to PNG and thermal data to TIFF or 16-bit PNG</li>
      <li>Zoom, pan, and browse through a folder of thermograms</li>
      <li>Translated to multiple languages</li>
    </ul>
  </description>

  <releases>
    <release version="2.2.0" date="2026-08-13" urgency="low" type="stable">
      <description>
        <p>Blackbody now opens Fluke thermograms! This release adds support for is2 files, both older binary and newer zip-style, from cameras such as the Ti400, Ti401p, TiS75+, and Ti25 — including the visible-light photo, embedded measurements, capture parameters, and the camera's palette. Other improvements:</p>
        <ul>
          <li>FLIR (and Fluke!) thermograms open in the render range embedded by the camera</li>
          <li>A more natural double-ended temperature range slider</li>
          <li>The info panel is available for all file formats, and panels recover gracefully when a file fails to load</li>
          <li>Blackbody can now open files from a file manager's "Open with" menu for JPEG, PNG, and TIFF files, including from within the Flatpak sandbox</li>
          <li>Improved keywords and categories make Blackbody easier to find</li>
        </ul>
      </description>
    </release>

    <release version="2.1.0" date="2026-07-20" urgency="low" type="stable">
      <description>
        <p>An incremental release improving how you browse and navigate thermograms:</p>
        <ul>
          <li>Added "Open folder…" (Ctrl+Shift+O) to browse a whole directory with the keyboard, working within the Flatpak sandbox via the file chooser portal</li>
          <li>Reduced Flatpak permissions: file access is now granted per file/folder via the portal instead of static filesystem access</li>
          <li>On-screen previous/next arrows appear when the directory has more thermograms to browse through</li>
          <li>Pressing a navigation key when only the open file is accessible shows a hint with a shortcut to open the folder instead</li>
          <li>The image can be dragged to pan when it is larger than the window</li>
        </ul>
      </description>
    </release>

    <release version="2.0.0" date="2026-07-18" urgency="low" type="stable">
      <description>
        <p>A major release porting Blackbody to GTK4 and libadwaita, with a redesigned interface and many new features:</p>
        <ul>
          <li>Completely redesigned user interface, dark by default, with on-screen temperature range sliders</li>
          <li>Overlay view (Picture-in-Picture or MSX) next to the thermal and visible spectrum views</li>
          <li>Embedded measurements (spots, lines, and areas) are now drawn on the render</li>
          <li>Temperatures can be shown in celsius, fahrenheit, or kelvin</li>
          <li>Information panel showing camera metadata and GPS location, with the option to open the location in a map</li>
          <li>Support for loading 16-bit centikelvin PNGs</li>
          <li>Scroll to zoom and keyboard navigation through all thermograms in a directory</li>
          <li>Palette choice is remembered when opening the next thermogram</li>
          <li>Improved export options and clearer error messages</li>
          <li>More supported FLIR cameras due to upgrading to flyr==0.7.0</li>
        </ul>
      </description>
    </release>

    <release version="1.3.0" date="2022-07-08" urgency="low" type="stable">
      <description>
        <p>This release overhauls the UI and adds important new features:</p>
        <ul>
          <li>Ability to view visual images (photos) in FLIR images</li>
          <li>Support for rendering thermal data to FLIR's embedded palettes</li>
          <li>Correcting for the rotation of a thermogram to show the image right side up</li>
        </ul>
      </description>
    </release>

    <release version="1.2.0" date="2021-01-02" urgency="low" type="stable">
      <description>
        <p>This release adds major interactivity improvements:</p>
        <ul>
          <li>Temperature in the render can be investigated by hovering over pixels</li>
          <li>Added a thermometer showing the colors and associated temperatures</li>
          <li>Thermogram renders can be saved to PNGs</li>
          <li>Thermograms' celsius data can be exported to tiff</li>
          <li>Allowed temperature range is now -273,15 to 1.000.000 instead of -99 to 99 (all °C)</li>
        </ul>
      </description>
    </release>

    <release version="1.1.0" date="2020-12-29" urgency="low" type="stable">
      <description>
        <p>A small, incremental update to Blackbody. Improvements:</p>
        <ul>
          <li>An error message is shown if opening a thermogram fails</li>
          <li>When opening fails, Blackbody doesn't unload any loaded thermograms anymore</li>
          <li>Added logo's heat waves as a nicer placeholder when no thermogram is opened yet</li>
          <li>Refined headerbar controls to only be sensitive when a thermogram is opened</li>
          <li>Three more known-to-be-compatible cameras (FLIR C2, FLIR E5 and FLIR P60)</li>
        </ul>
      </description>
    </release>

    <release version="1.0.0" date="2020-12-28" urgency="low" type="stable">
      <description>
        <p>First release of Blackbody. The most important features are:</p>
        <ul>
          <li>Loading FLIR thermograms from many cameras</li>
          <li>Loading single-band TIFFs assumed to be in °C</li>
          <li>Rendering to many different color palettes, including inferno and turbo</li>
          <li>Specifying the thermal range to render</li>
          <li>Zooming in and out</li>
          <li>Translated to multiple languages</li>
          <li>Available for Linux and Windows</li>
        </ul>
      </description>
    </release>
  </releases>

