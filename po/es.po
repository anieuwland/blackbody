#: data/eu.nimmerfort.blackbody.desktop.in:2
#: data/eu.nimmerfort.blackbody.appdata.xml.in:4
#: src/resources/eu.nimmerfort.blackbody.ui:111
msgid "Blackbody"
msgstr "Blackbody"

#: data/eu.nimmerfort.blackbody.desktop.in:3
#: data/eu.nimmerfort.blackbody.appdata.xml.in:5
msgid "A thermogram viewer"
msgstr "Un visor de termogramas"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:14
msgid "Arthur Nieuwland"
msgstr "Arthur Nieuwland"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:19
msgid ""
"Blackbody is a viewer for FLIR thermograms and other thermal images. Explore "
"temperatures under the cursor, render to different palettes and ranges, "
"overlay the visible-light photo, and inspect embedded measurements and "
"camera metadata."
msgstr ""
"Blackbody es un visor de termogramas FLIR y otras imágenes térmicas. "
"Explore las temperaturas bajo el cursor, renderice con diferentes paletas y "
"rangos, superponga la foto de luz visible e inspeccione las mediciones "
"integradas y los metadatos de la cámara."

#: data/eu.nimmerfort.blackbody.appdata.xml.in:20
msgid "Features:"
msgstr "Características:"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:22
msgid "Loading FLIR thermograms from many cameras, both thermal and photo data"
msgstr ""
"Carga de termogramas FLIR desde muchas cámaras, con datos térmicos y "
"fotográficos"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:23
msgid "Loading single-band TIFFs and 16-bit centikelvin PNGs"
msgstr "Carga de TIFF de un solo canal y PNG de 16 bits en centikelvin"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:24
msgid "Investigating temperatures with the mouse"
msgstr "Investigar temperaturas con el ratón"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:25
msgid "Viewing embedded measurements: spots, lines, and areas"
msgstr "Visualización de mediciones integradas: puntos, líneas y áreas"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:26
msgid ""
"Overlay view, also known as Picture-in-Picture or MSX, combining thermal and "
"visible images"
msgstr ""
"Vista de superposición, también conocida como imagen en imagen o MSX, que "
"combina las imágenes térmica y visible"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:27
msgid "Temperatures in celsius, fahrenheit, or kelvin"
msgstr "Temperaturas en Celsius, Fahrenheit o Kelvin"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:28
msgid "Metadata panel with camera info and GPS location, openable in a map"
msgstr ""
"Panel de metadatos con información de la cámara y ubicación GPS, que se "
"puede abrir en un mapa"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:29
msgid ""
"Exporting renders to PNG and thermal data to TIFF or 16-bit centikelvin PNG"
msgstr ""
"Exportar renders a PNG y datos térmicos a TIFF o PNG de 16 bits en "
"centikelvin"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:30
msgid "Rendering to embedded color palettes, if present"
msgstr "Renderizado con paletas de colores integradas, si las hay"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:31
#: data/eu.nimmerfort.blackbody.appdata.xml.in:101
msgid ""
"Rendering to many different colors palettes, including inferno and turbo"
msgstr "Renderizado con muchas paletas de colores, incluyendo inferno y turbo"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:32
#: data/eu.nimmerfort.blackbody.appdata.xml.in:102
msgid "Specifying the thermal range to render"
msgstr "Especificar el rango térmico a renderizar"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:33
#: data/eu.nimmerfort.blackbody.appdata.xml.in:103
msgid "Zooming in and out"
msgstr "Acercar y alejar la imagen"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:34
#: data/eu.nimmerfort.blackbody.appdata.xml.in:104
msgid "Translated to multiple languages"
msgstr "Traducido a varios idiomas"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:35
msgid "Most FLIR cameras known to work"
msgstr "Compatibilidad conocida con la mayoría de las cámaras FLIR"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:42
msgid ""
"A major release porting Blackbody to GTK4 and libadwaita, with a redesigned "
"interface and many new features:"
msgstr ""
"Una versión mayor que porta Blackbody a GTK4 y libadwaita, con una interfaz "
"rediseñada y muchas características nuevas:"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:44
msgid ""
"Completely redesigned user interface, dark by default, with on-screen "
"temperature range sliders"
msgstr ""
"Interfaz de usuario completamente rediseñada, oscura de forma "
"predeterminada, con deslizadores de rango de temperatura en pantalla"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:45
msgid ""
"Overlay view (Picture-in-Picture or MSX) next to the thermal and visible "
"spectrum views"
msgstr ""
"Vista de superposición (imagen en imagen o MSX) junto a las vistas térmica "
"y de espectro visible"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:46
msgid ""
"Embedded measurements (spots, lines, and areas) are now drawn on the render"
msgstr ""
"Las mediciones integradas (puntos, líneas y áreas) ahora se dibujan sobre "
"el render"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:47
msgid "Temperatures can be shown in celsius, fahrenheit, or kelvin"
msgstr "Las temperaturas se pueden mostrar en Celsius, Fahrenheit o Kelvin"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:48
msgid ""
"Information panel showing camera metadata and GPS location, with the option "
"to open the location in a map"
msgstr ""
"Panel de información que muestra los metadatos de la cámara y la ubicación "
"GPS, con la opción de abrir la ubicación en un mapa"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:49
msgid "Support for loading 16-bit centikelvin PNGs"
msgstr "Compatibilidad con la carga de PNG de 16 bits en centikelvin"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:50
msgid ""
"Scroll to zoom and keyboard navigation through all thermograms in a directory"
msgstr ""
"Desplazamiento para ampliar y navegación con el teclado por todos los "
"termogramas de una carpeta"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:51
msgid "Palette choice is remembered when opening the next thermogram"
msgstr "La paleta elegida se recuerda al abrir el siguiente termograma"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:52
msgid "Improved export options and clearer error messages"
msgstr "Opciones de exportación mejoradas y mensajes de error más claros"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:53
msgid "More supported FLIR cameras due to upgrading to flyr==0.7.0"
msgstr ""
"Más cámaras FLIR compatibles gracias a la actualización a flyr==0.7.0"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:60
msgid "This release overhauls the UI and adds important new features:"
msgstr ""
"Esta versión renueva la interfaz y añade características nuevas importantes:"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:62
msgid "Ability to view optical images (photos) in FLIR images"
msgstr "Posibilidad de ver las imágenes ópticas (fotos) de las imágenes FLIR"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:63
msgid "Support for rendering thermal data to FLIR's embedded palettes"
msgstr ""
"Compatibilidad con el renderizado de datos térmicos con las paletas "
"integradas de FLIR"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:64
msgid ""
"Correcting for the rotation of a thermogram to show the image right side up"
msgstr ""
"Corrección de la rotación del termograma para mostrar la imagen con la "
"orientación correcta"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:71
msgid "This release adds major interactivity improvements:"
msgstr "Esta versión añade importantes mejoras de interactividad:"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:73
msgid "Temperature in the render can be investigated by hovering over pixels"
msgstr ""
"La temperatura del render se puede investigar pasando el cursor sobre los "
"píxeles"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:74
msgid "Added a thermometer showing the colors and associated temperatures"
msgstr ""
"Añadido un termómetro que muestra los colores y sus temperaturas asociadas"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:75
msgid "Thermogram renders can be saved to PNGs"
msgstr "Los renders de termogramas se pueden guardar como PNG"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:76
msgid "Thermograms' celsius data can be exported to tiff"
msgstr ""
"Los datos en Celsius de los termogramas se pueden exportar a TIFF"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:77
msgid ""
"Allowed temperature range is now -273,15 to 1.000.000 instead of -99 to 99 "
"(all °C)"
msgstr ""
"El rango de temperatura permitido ahora es de -273,15 a 1.000.000 en lugar "
"de -99 a 99 (todo en °C)"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:84
msgid "A small, incremental update to Blackbody. Improvements:"
msgstr "Una actualización pequeña e incremental de Blackbody. Mejoras:"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:86
msgid "An error message is shown if opening a thermogram fails"
msgstr "Se muestra un mensaje de error si falla la apertura de un termograma"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:87
msgid ""
"When opening fails, Blackbody doesn't unload any loaded thermograms anymore"
msgstr ""
"Cuando falla la apertura, Blackbody ya no descarga los termogramas ya "
"cargados"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:88
msgid ""
"Added logo's heat waves as a nicer placeholder when no thermogram is opened "
"yet"
msgstr ""
"Añadidas las ondas de calor del logotipo como un marcador de posición más "
"agradable cuando aún no se ha abierto ningún termograma"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:89
msgid ""
"Refined headerbar controls to only be sensitive when a thermogram is opened"
msgstr ""
"Controles de la barra de cabecera refinados para estar activos solo cuando "
"hay un termograma abierto"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:90
msgid ""
"Three more known-to-be-compatible cameras (FLIR C2, FLIR E5 and FLIR P60)"
msgstr ""
"Tres cámaras compatibles conocidas más (FLIR C2, FLIR E5 y FLIR P60)"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:97
msgid "First release of Blackbody. The most important features are:"
msgstr ""
"Primera versión de Blackbody. Las características más importantes son:"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:99
msgid "Loading FLIR thermograms from many cameras"
msgstr "Carga de termogramas FLIR desde muchas cámaras"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:100
msgid "Loading single-band TIFFs assumed to be in °C"
msgstr "Carga de TIFF de un solo canal, asumiendo que están en °C"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:105
msgid "Available for Linux and Windows"
msgstr "Disponible para Linux y Windows"

#: data/eu.nimmerfort.blackbody.appdata.xml.in:113
msgid ""
"A thermogram of a bird in °Celsius, in Blackbody's default view using the "
"embedded palette."
msgstr ""
"Un termograma de un pájaro en grados Celsius, en la vista predeterminada de "
"Blackbody con la paleta integrada."

#: data/eu.nimmerfort.blackbody.appdata.xml.in:117
msgid ""
"Blackbody's info pane of a high quality FLIR SC660 camera, in °Fahrenheit."
msgstr ""
"El panel de información de Blackbody de una cámara FLIR SC660 de alta "
"calidad, en grados Fahrenheit."

#: data/eu.nimmerfort.blackbody.appdata.xml.in:121
msgid "Spot measurements on a thermogram in °Fahrenheit with a custom palette."
msgstr ""
"Mediciones de punto en un termograma en grados Fahrenheit con una paleta "
"personalizada."

#: data/eu.nimmerfort.blackbody.appdata.xml.in:125
msgid ""
"A thermogram in Kelvin laid over the visible spectrum photo, using a custom "
"palette."
msgstr ""
"Un termograma en Kelvin superpuesto sobre la foto de espectro visible, con "
"una paleta personalizada."

#: data/eu.nimmerfort.blackbody.appdata.xml.in:129
msgid "Zoomed in on a cat's head with a custom palette and temperature range."
msgstr ""
"Ampliación de la cabeza de un gato con una paleta y un rango de temperatura "
"personalizados."

#: data/eu.nimmerfort.blackbody.gschema.xml:11
msgid "Temperature unit"
msgstr "Unidad de temperatura"

#: data/eu.nimmerfort.blackbody.gschema.xml:12
msgid "The unit temperatures are displayed in."
msgstr "La unidad en la que se muestran las temperaturas."

