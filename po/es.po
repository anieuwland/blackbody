#~ msgid ""
#~ "Blackbody is a thermogram viewer. It allows viewing FLIR JPEG, TIFF, and "
#~ "16-bit centikelvin PNG thermograms, giving control over the render "
#~ "settings."
#~ msgstr ""
#~ "Blackbody es un visor de termogramas. Permite ver termogramas FLIR JPEG, "
#~ "TIFF y PNG de 16 bits en centikelvin, con control sobre los ajustes de "
#~ "renderizado."

#~ msgid "Optical view"
#~ msgstr "Vista óptica"

#~ msgid "Picture-in-picture"
#~ msgstr "Imagen en imagen"
