<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>

  <menu id="zoom_menu_model">
    <item>
      <attribute name="label" translatable="yes">Fit</attribute>
      <attribute name="action">win.zoom-fit</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">50%</attribute>
      <attribute name="action">win.set-zoom</attribute>
      <attribute name="target" type="i">50</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">67%</attribute>
      <attribute name="action">win.set-zoom</attribute>
      <attribute name="target" type="i">67</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">100%</attribute>
      <attribute name="action">win.set-zoom</attribute>
      <attribute name="target" type="i">100</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">200%</attribute>
      <attribute name="action">win.set-zoom</attribute>
      <attribute name="target" type="i">200</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">400%</attribute>
      <attribute name="action">win.set-zoom</attribute>
      <attribute name="target" type="i">400</attribute>
    </item>
  </menu>

  <menu id="app_menu_model">
    <section>
      <item>
        <attribute name="label" translatable="yes">New window</attribute>
        <attribute name="action">app.new-window</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Open thermogram…</attribute>
        <attribute name="action">win.open</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Open folder…</attribute>
        <attribute name="action">win.open-folder</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Export thermogram…</attribute>
        <attribute name="action">win.export</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save render…</attribute>
        <attribute name="action">win.render</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Celsius</attribute>
        <attribute name="action">app.temperature-unit</attribute>
        <attribute name="target">celsius</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Fahrenheit</attribute>
        <attribute name="action">app.temperature-unit</attribute>
        <attribute name="target">fahrenheit</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Kelvin</attribute>
        <attribute name="action">app.temperature-unit</attribute>
        <attribute name="target">kelvin</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">About Blackbody</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>

  <object class="GtkFileFilter" id="filter_thermograms">
    <mime-types>
      <mime-type>image/jpeg</mime-type>
      <mime-type>image/tiff</mime-type>
      <mime-type>image/png</mime-type>
    </mime-types>
  </object>
  <object class="GtkFileFilter" id="filter_all_files">
    <patterns><pattern>*</pattern></patterns>
  </object>

  <object class="GtkAdjustment" id="min_temp_adj">
    <property name="lower">-273.15</property>
    <property name="upper">1000000</property>
    <property name="value">0</property>
    <property name="step-increment">0.5</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="max_temp_adj">
    <property name="lower">-273.15</property>
    <property name="upper">1000000</property>
    <property name="value">20</property>
    <property name="step-increment">0.5</property>
    <property name="page-increment">5</property>
  </object>

  <object class="AdwApplicationWindow" id="blackbody_window">
    <property name="title" translatable="yes">Blackbody</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <child>
      <object class="AdwToolbarView" id="outer_toolbar_view">

        <child type="top">
          <object class="AdwHeaderBar" id="headerbar">

            <!-- Start: Mode switcher (thermal/visible/overlay) -->
            <child>
              <object class="AdwToggleGroup" id="mode_group">
                <property name="sensitive">false</property>
                <child>
                  <object class="AdwToggle">
                    <property name="name">thermal</property>
                    <property name="label" translatable="yes">Thermal</property>
                    <property name="tooltip" translatable="yes">Thermal image</property>
                  </object>
                </child>
                <child>
                  <object class="AdwToggle">
                    <property name="name">visible</property>
                    <property name="label" translatable="yes">Visible</property>
                    <property name="tooltip" translatable="yes">Visible-light photo</property>
                  </object>
                </child>
                <child>
                  <object class="AdwToggle">
                    <property name="name">overlay</property>
                    <property name="label" translatable="yes">Overlay</property>
                    <property name="tooltip" translatable="yes">Thermal picture-in-picture over the photo</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- End: Overflow menu (rightmost), then info -->
            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main menu</property>
                <property name="menu-model">app_menu_model</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkToggleButton" id="info_button">
                <property name="icon-name">info-outline-symbolic</property>
                <property name="tooltip-text" translatable="yes">Camera info</property>
                <property name="sensitive">false</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkToggleButton" id="measurements_button">
                <property name="icon-name">find-location-symbolic</property>
                <property name="tooltip-text" translatable="yes">Measurements</property>
                <property name="sensitive">false</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkMenuButton" id="palette_button">
                <property name="icon-name">preferences-color-symbolic</property>
                <property name="tooltip-text" translatable="yes">Choose colour palette</property>
                <property name="popover">
                  <object class="GtkPopover" id="palette_popover">
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="max-content-height">400</property>
                        <property name="propagate-natural-height">true</property>
                        <property name="propagate-natural-width">true</property>
                        <property name="child">
                          <object class="GtkBox" id="palette_box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

          </object><!-- AdwHeaderBar -->
        </child>

        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
          <object class="AdwOverlaySplitView" id="info_split_view">
            <property name="sidebar-position">end</property>
            <property name="show-sidebar">false</property>
            <property name="sidebar">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkBox" id="info_sidebar">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="measurements_sidebar">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="content">
              <object class="GtkBox" id="canvas_box">
                <property name="orientation">horizontal</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
            <child>
              <object class="GtkOverlay" id="canvas_overlay">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolled_window">
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <property name="child">
                      <object class="GtkDrawingArea" id="viewed_image">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                      </object>
                    </property>
                  </object>
                </property>
                <child type="overlay">
                  <!-- Transparent row: positions the OSD pills at the same height.
                       The range bar expands to fill whatever the other pills
                       don't use, including the nav bar's slot when hidden. -->
                  <object class="GtkBox" id="osd_container">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">16</property>
                    <property name="halign">fill</property>
                    <property name="valign">end</property>
                    <property name="margin-start">16</property>
                    <property name="margin-end">16</property>
                    <property name="margin-bottom">16</property>
                    <child>
                      <!-- Directory navigation pill, only visible when the
                           open file has browsable siblings -->
                      <object class="GtkBox" id="nav_bar">
                        <property name="orientation">horizontal</property>
                        <property name="visible">false</property>
                        <style><class name="osd"/><class name="linked"/></style>
                        <child>
                          <object class="GtkButton" id="nav_prev_button">
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Previous thermogram (Left)</property>
                            <style><class name="flat"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="nav_next_button">
                            <property name="icon-name">go-next-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Next thermogram (Right)</property>
                            <style><class name="flat"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="range_bar">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">6</property>
                        <property name="hexpand">true</property>
                        <style><class name="osd"/></style>
                        <child>
                          <object class="GtkLabel" id="min_label">
                            <property name="label">0.0 °C</property>
                            <property name="width-chars">8</property>
                            <property name="xalign">0</property>
                            <property name="margin-start">8</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">0</property>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkScale" id="min_scale">
                                <property name="adjustment">min_temp_adj</property>
                                <property name="draw-value">false</property>
                                <property name="hexpand">true</property>
                                <property name="inverted">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScale" id="max_scale">
                                <property name="adjustment">max_temp_adj</property>
                                <property name="draw-value">false</property>
                                <property name="hexpand">true</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="max_label">
                            <property name="label">20.0 °C</property>
                            <property name="width-chars">8</property>
                            <property name="xalign">1</property>
                            <property name="margin-end">8</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuButton" id="zoom_button">
                        <property name="always-show-arrow">true</property>
                        <property name="tooltip-text" translatable="yes">Zoom</property>
                        <property name="sensitive">false</property>
                        <style><class name="osd"/></style>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="spacing">4</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">system-search-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="zoom_label">
                                <property name="label" translatable="yes">Fit</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="menu-model">zoom_menu_model</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object><!-- GtkOverlay -->
            </child>
            <child>
              <object class="GtkDrawingArea" id="color_bar">
                <property name="width-request">20</property>
                <property name="vexpand">true</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
              </object>
            </child>
              </object><!-- GtkBox canvas_box -->
            </property>
          </object><!-- AdwOverlaySplitView -->
            </property>
          </object><!-- AdwToastOverlay -->
        </property>

      </object><!-- outer AdwToolbarView -->
    </child>
  </object><!-- AdwApplicationWindow -->
</interface>
