<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1"/>

  <object class="GMenu" id="app_menu_model">
    <item>
      <attribute name="label" translatable="yes">Export thermal…</attribute>
      <attribute name="action">app.export</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Save render…</attribute>
      <attribute name="action">app.render</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">About Blackbody</attribute>
      <attribute name="action">app.about</attribute>
    </item>
  </object>

  <object class="GtkFileFilter" id="filter_thermograms">
    <mime-types>
      <mime-type>image/jpeg</mime-type>
      <mime-type>image/tiff</mime-type>
    </mime-types>
  </object>
  <object class="GtkFileFilter" id="filter_all_files">
    <patterns><pattern>*</pattern></patterns>
  </object>

  <object class="GtkAdjustment" id="min_temp_adj">
    <property name="lower">-273.15</property>
    <property name="upper">1000000</property>
    <property name="value">0</property>
    <property name="step-increment">0.5</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="max_temp_adj">
    <property name="lower">-273.15</property>
    <property name="upper">1000000</property>
    <property name="value">20</property>
    <property name="step-increment">0.5</property>
    <property name="page-increment">5</property>
  </object>

  <object class="AdwApplicationWindow" id="blackbody_window">
    <property name="title" translatable="yes">Blackbody</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <child>
      <object class="AdwToolbarView" id="outer_toolbar_view">

        <child type="top">
          <object class="AdwHeaderBar" id="headerbar">

            <!-- Start: Open button -->
            <child>
              <object class="GtkButton" id="open_button">
                <property name="icon-name">document-open-symbolic</property>
                <property name="tooltip-text" translatable="yes">Open thermogram</property>
              </object>
            </child>

            <!-- Start: Mode switcher [T][O][P] -->
            <child>
              <object class="GtkBox" id="mode_box">
                <style><class name="linked"/></style>
                <child>
                  <object class="GtkToggleButton" id="mode_thermal">
                    <property name="label" translatable="yes">T</property>
                    <property name="active">true</property>
                    <property name="tooltip-text" translatable="yes">Thermal view</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="mode_optical">
                    <property name="label" translatable="yes">O</property>
                    <property name="tooltip-text" translatable="yes">Optical view</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="mode_pip">
                    <property name="label" translatable="yes">P</property>
                    <property name="sensitive">false</property>
                    <property name="tooltip-text" translatable="yes">Picture-in-picture</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- End: Overflow menu -->
            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main menu</property>
                <property name="menu-model">app_menu_model</property>
              </object>
            </child>

            <!-- End: Palette picker button -->
            <child type="end">
              <object class="GtkMenuButton" id="palette_button">
                <property name="icon-name">preferences-color-symbolic</property>
                <property name="tooltip-text" translatable="yes">Choose colour palette</property>
                <property name="popover">
                  <object class="GtkPopover" id="palette_popover">
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="max-content-height">400</property>
                        <property name="propagate-natural-height">true</property>
                        <property name="child">
                          <object class="GtkBox" id="palette_box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

          </object><!-- AdwHeaderBar -->
        </child>

        <property name="content">
          <!-- GtkOverlay: inner toolbar as base, zoom button as overlay -->
          <object class="GtkOverlay" id="canvas_overlay">
            <property name="child">
              <object class="AdwToolbarView" id="inner_toolbar_view">
                <property name="content">
                  <object class="GtkBox" id="canvas_box">
                    <property name="orientation">horizontal</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolled_window">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="child">
                          <object class="GtkPicture" id="viewed_image">
                            <property name="content-fit">contain</property>
                            <property name="can-shrink">true</property>
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDrawingArea" id="color_bar">
                        <property name="width-request">48</property>
                        <property name="vexpand">true</property>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="bottom">
                  <object class="GtkBox" id="range_bar">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <child>
                      <object class="GtkLabel" id="min_label">
                        <property name="label">0.0 °C</property>
                        <property name="width-chars">8</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale" id="min_scale">
                        <property name="adjustment">min_temp_adj</property>
                        <property name="draw-value">false</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale" id="max_scale">
                        <property name="adjustment">max_temp_adj</property>
                        <property name="draw-value">false</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="max_label">
                        <property name="label">20.0 °C</property>
                        <property name="width-chars">8</property>
                        <property name="xalign">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="auto_button">
                        <property name="label" translatable="yes">Auto</property>
                        <property name="tooltip-text" translatable="yes">Snap range to image min/max</property>
                        <property name="sensitive">false</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object><!-- inner AdwToolbarView -->
            </property>

            <!-- Zoom button overlay: bottom-right corner -->
            <child type="overlay">
              <object class="GtkMenuButton" id="zoom_button">
                <property name="halign">end</property>
                <property name="valign">end</property>
                <property name="margin-bottom">16</property>
                <property name="margin-end">16</property>
                <property name="icon-name">zoom-fit-best-symbolic</property>
                <property name="tooltip-text" translatable="yes">Zoom</property>
                <property name="sensitive">false</property>
                <style>
                  <class name="osd"/>
                  <class name="circular"/>
                </style>
                <property name="popover">
                  <object class="GtkPopover" id="zoom_popover">
                    <property name="child">
                      <object class="GtkListBox" id="zoom_list">
                        <property name="selection-mode">none</property>
                        <child>
                          <object class="GtkListBoxRow" id="zoom_fit">
                            <property name="child">
                              <object class="GtkLabel"><property name="label">Fit</property></object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBoxRow" id="zoom_25">
                            <property name="child">
                              <object class="GtkLabel"><property name="label">25%</property></object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBoxRow" id="zoom_50">
                            <property name="child">
                              <object class="GtkLabel"><property name="label">50%</property></object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBoxRow" id="zoom_100">
                            <property name="child">
                              <object class="GtkLabel"><property name="label">100%</property></object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBoxRow" id="zoom_150">
                            <property name="child">
                              <object class="GtkLabel"><property name="label">150%</property></object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBoxRow" id="zoom_200">
                            <property name="child">
                              <object class="GtkLabel"><property name="label">200%</property></object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>

          </object><!-- GtkOverlay -->
        </property>

      </object><!-- outer AdwToolbarView -->
    </child>
  </object><!-- AdwApplicationWindow -->
</interface>
