{
    "app-id" : "eu.nimmerfort.blackbody",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "build-args" : [
            "--share=network"
        ],
        "env" : {
            "BLACKBODY_BUILDER" : "default",
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "blackbody=debug"
        }
    },
    "command" : "blackbody",
    "finish-args" : [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "modules" : [
        {
            "builddir" : true,
            "buildsystem" : "meson",
            "name" : "blackbody",
            "config-opts" : [
                "--buildtype=debug"
            ],
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}
